{
  "name": "saved-feed",
  "private": true,
  "version": "0.1.0",
  "description": "Turn your Instagram saved posts into a calm, daily, swipeable feed.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=1 vite",
    "build": "tsc -b && vite build",
